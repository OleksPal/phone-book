@page "/"

@using Radzen
@using Radzen.Blazor
@using PhoneBook.Frontend.Services

@inject DialogService DialogService
@inject PhoneBookApi PhoneBookApi

<PageTitle>Phone Contacts</PageTitle>

<div class="container-fluid py-4">

    <RadzenCard Style="padding: 0; overflow: hidden;">

        <RadzenCard class="mb-3">
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="1rem"
                         AlignItems="AlignItems.End">

                <div style="flex: 1;">
                    <RadzenLabel Text="First Name" />
                    <RadzenTextBox @bind-Value="filter.FirstName"
                                   Style="width:100%" />
                </div>

                <div style="flex: 1;">
                    <RadzenLabel Text="Last Name" />
                    <RadzenTextBox @bind-Value="filter.LastName"
                                   Style="width:100%" />
                </div>

                <div style="flex: 1;">
                    <RadzenLabel Text="Phone" />
                    <RadzenTextBox @bind-Value="filter.PhoneNumber"
                                   Style="width:100%" />
                </div>

                <RadzenButton Text="Search"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@Search" />

                <RadzenButton Text="Clear"
                              Icon="clear"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@ClearFilter" />

            </RadzenStack>
        </RadzenCard>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="mb-0">Phone Contacts</h4>
                <small class="text-muted">@contacts.Length contacts</small>
            </div>

            <RadzenButton Text="Add Contact"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(async () => await AddContact())" />
        </div>


        <RadzenDataGrid Data="@contacts"
                        TItem="PhoneContact"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        AllowFiltering="false"
                        AllowColumnResize="true"
                        ShowPagingSummary="true"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">

            <Columns>

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.FirstName)"
                                      Title="First Name"
                                      Width="180px" />

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.LastName)"
                                      Title="Last Name"
                                      Width="180px" />

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.PhoneNumber)"
                                      Title="Phone"
                                      Width="200px">

                    <Template Context="contact">
                        <span>
                            <i class="bi bi-telephone text-primary me-2"></i>
                            @contact.PhoneNumber
                        </span>
                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.Email)"
                                      Title="Email"
                                      Width="280px">

                    <Template Context="contact">
                        <span>
                            <i class="bi bi-envelope text-primary me-2"></i>
                            @contact.Email
                        </span>
                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Title="Actions"
                                      Width="130px"
                                      Sortable="false"
                                      Filterable="false">

                    <Template Context="contact">

                        <RadzenButton Icon="edit"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@(async () => await EditContact(contact))" />

                        <RadzenButton Icon="delete"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      class="ms-2"
                                      Click="@(async () => await DeleteContact(contact))" />

                    </Template>

                </RadzenDataGridColumn>


            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</div>

@code {
    private PhoneContact[] contacts = Array.Empty<PhoneContact>();
    private bool isLoading = true;
    private string? errorMessage;

    private PhoneContactFilter filter = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var filter = new PhoneContactFilter();

            contacts = await PhoneBookApi.GetContactsAsync(filter);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load contacts.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddContact()
    {
        var result = await DialogService.OpenAsync<EditContactDialog>(
            "Add Contact",
            new Dictionary<string, object>
            {
            { "Contact", new PhoneContact() }
            },
            new DialogOptions
            {
                Width = "500px",
                Resizable = false,
                Draggable = true
            });

        if (result is PhoneContact newContact)
        {
            await PhoneBookApi.CreateContactAsync(newContact);

            contacts = contacts
                .Append(newContact)
                .ToArray();
        }
    }


    private async Task EditContact(PhoneContact contact)
    {
        var result = await DialogService.OpenAsync<EditContactDialog>(
            "Edit Contact",
            new Dictionary<string, object>
            {
            { "Contact", contact }
            },
            new DialogOptions
            {
                Width = "500px",
                Resizable = false,
                Draggable = true
            });

        if (result is PhoneContact updatedContact)
        {
            await PhoneBookApi.UpdateContactAsync(updatedContact);

            var index = Array.FindIndex(
                contacts,
                x => x.Id == updatedContact.Id);

            if (index >= 0)
            {
                contacts[index] = updatedContact;
                contacts = contacts.ToArray();
            }
        }
    }

    private async Task DeleteContact(PhoneContact contact)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete {contact.FirstName} {contact.LastName}?",
            "Delete Contact",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await PhoneBookApi.DeleteContactAsync(contact.Id);

            contacts = contacts
                .Where(x => x.Id != contact.Id)
                .ToArray();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to delete contact.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task Search()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            contacts = await PhoneBookApi.GetContactsAsync(filter);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load contacts.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilter()
    {
        filter = new PhoneContactFilter();

        await Search();
    }


}
