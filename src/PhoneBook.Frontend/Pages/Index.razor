@page "/"

@using PhoneBook.Frontend.Components
@using Radzen
@using Radzen.Blazor
@using PhoneBook.Frontend.Services

@inject DialogService DialogService
@inject PhoneBookService PhoneBookService

<PageTitle>Phone Contacts</PageTitle>

<div class="container-fluid py-4">

    <RadzenCard Style="padding: 0; overflow: hidden;">

        <ContactFilter
            Filter="@filter"
            Search="@Search"
            Clear="@ClearFilter" />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="ms-2">
                <h4 class="mb-0">Phone Contacts</h4>
                <small class="text-muted">@totalCount contacts</small>
            </div>

            <RadzenButton Text="Add Contact"
                          Icon="add"
                          class="me-2"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(async () => await AddContact())" />
        </div>


        <ContactGrid @ref="contactGrid"
                     Contacts="@contacts"
                     TotalCount="@totalCount"
                     PageSize="@pageSize"
                     LoadData="@LoadData"
                     Edit="@EditContact"
                     Delete="@DeleteContact" />

    </RadzenCard>

</div>

@code {
    private IEnumerable<PhoneContact> contacts = new List<PhoneContact>();

    private int totalCount;
    private int pageSize = 10;

    private string sortColumn = "LastName";
    private string sortOrder = "asc";

    private bool isLoading = true;
    private string? errorMessage;

    private ContactGrid? contactGrid;

    private PhoneContactFilter filter = new();

    private static DialogOptions ContactDialogOptions => new()
    {
        Width = "500px",
        Resizable = false,
        Draggable = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadFirstPage();
    }

    private async Task LoadData(LoadDataArgs args)
    {
        try
        {
            var skip = args.Skip ?? 0;
            var top = args.Top ?? pageSize;

            UpdateSorting(args.OrderBy);

            var pageNumber = (skip / top) + 1;

            pageSize = top;

            isLoading = true;
            errorMessage = null;

            var result = await PhoneBookService.GetContactsAsync(
                filter,
                pageNumber, pageSize,
                sortColumn, sortOrder);

            contacts = result.Items;
            totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load contacts.";
            Console.Error.WriteLine(ex);

            contacts = Array.Empty<PhoneContact>();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddContact()
    {
        var newContact = await OpenContactDialog(
            "Add Contact",
            new PhoneContact());

        if (newContact is null)
            return;

        await PhoneBookService.CreateContactAsync(newContact);

        await contactGrid!.Reload();
    }

    private async Task EditContact(PhoneContact contact)
    {
        var updatedContact = await OpenContactDialog(
            "Edit Contact",
            contact);

        if (updatedContact is null)
            return;

        await PhoneBookService.UpdateContactAsync(updatedContact);

        await contactGrid!.Reload();
    }

    private async Task DeleteContact(PhoneContact contact)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete {contact.FirstName} {contact.LastName}?",
            "Delete Contact",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await PhoneBookService.DeleteContactAsync(contact.Id);

            await contactGrid!.Reload();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to delete contact.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task Search()
    {
        await LoadFirstPage();

        await contactGrid!.FirstPage();
    }

    private async Task ClearFilter()
    {
        filter = new PhoneContactFilter();

        await Search();
    }

    private void UpdateSorting(string? orderBy)
    {
        if (string.IsNullOrWhiteSpace(orderBy))
        {
            sortColumn = "LastName";
            sortOrder = "asc";
            return;
        }

        var parts = orderBy.Split(' ');

        sortColumn = parts[0];
        sortOrder = parts.Length > 1
            ? parts[1].ToLower()
            : "asc";
    }

    private async Task LoadFirstPage()
    {
        await LoadData(new LoadDataArgs
        {
            Skip = 0,
            Top = pageSize,
            OrderBy = $"{sortColumn} {sortOrder}"
        });
    }

    private async Task<PhoneContact?> OpenContactDialog(
        string title,
        PhoneContact contact)
    {
        var result = await DialogService.OpenAsync<ContactDialog>(
            title,
            new Dictionary<string, object>
            {
                ["Contact"] = contact
            },
            ContactDialogOptions);

        return result as PhoneContact;
    }
}
