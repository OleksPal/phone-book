@page "/"

@using Radzen
@using Radzen.Blazor
@using PhoneBook.Frontend.Services

@inject DialogService DialogService
@inject PhoneBookService PhoneBookApi

<PageTitle>Phone Contacts</PageTitle>

<div class="container-fluid py-4">

    <RadzenCard Style="padding: 0; overflow: hidden;">

        <RadzenCard class="mb-3">
            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="1rem"
                         AlignItems="AlignItems.End">

                <div style="flex: 1;">
                    <RadzenLabel Text="First Name" />
                    <RadzenTextBox @bind-Value="filter.FirstName"
                                   Style="width:100%" />
                </div>

                <div style="flex: 1;">
                    <RadzenLabel Text="Last Name" />
                    <RadzenTextBox @bind-Value="filter.LastName"
                                   Style="width:100%" />
                </div>

                <div style="flex: 1;">
                    <RadzenLabel Text="Phone" />
                    <RadzenTextBox @bind-Value="filter.PhoneNumber"
                                   Style="width:100%" />
                </div>

                <div style="flex: 1;">
                    <RadzenLabel Text="Email" />
                    <RadzenTextBox @bind-Value="filter.Email"
                                   Style="width:100%" />
                </div>

                <RadzenButton Text="Search"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@Search" />

                <RadzenButton Text="Clear"
                              Icon="clear"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@ClearFilter" />

            </RadzenStack>
        </RadzenCard>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="ms-2">
                <h4 class="mb-0">Phone Contacts</h4>
                <small class="text-muted">@totalCount contacts</small>
            </div>

            <RadzenButton Text="Add Contact"
                          Icon="add"
                          class="me-2"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(async () => await AddContact())" />
        </div>


        <RadzenDataGrid @ref="grid"
                        Data="@contacts"
                        TItem="PhoneContact"
                        Count="@totalCount"
                        LoadData="@LoadData"
                        AllowPaging="true"
                        PageSize="@pageSize"
                        AllowSorting="true"
                        AllowFiltering="false"
                        AllowColumnResize="true"
                        ShowPagingSummary="true"
                        GridLines="DataGridGridLines.Both"
                        Density="Density.Compact">

            <Columns>

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.FirstName)"
                                      Title="First Name"
                                      Width="180px" />

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.LastName)"
                                      Title="Last Name"
                                      Width="180px" />

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.PhoneNumber)"
                                      Title="Phone"
                                      Width="200px">

                    <Template Context="contact">
                        <span>
                            <i class="bi bi-telephone text-primary me-2"></i>
                            @contact.PhoneNumber
                        </span>
                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Property="@nameof(PhoneContact.Email)"
                                      Title="Email"
                                      Width="280px">

                    <Template Context="contact">
                        <span>
                            <i class="bi bi-envelope text-primary me-2"></i>
                            @contact.Email
                        </span>
                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="PhoneContact"
                                      Title="Actions"
                                      Width="130px"
                                      Sortable="false"
                                      Filterable="false">

                    <Template Context="contact">

                        <div class="d-flex justify-content-around align-items-center w-100">
                            <RadzenButton Icon="edit"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small"
                                          Click="@(async () => await EditContact(contact))" />

                            <RadzenButton Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Click="@(async () => await DeleteContact(contact))" />
                        </div>

                    </Template>

                </RadzenDataGridColumn>


            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</div>

@code {
    private IEnumerable<PhoneContact> contacts = new List<PhoneContact>();

    private int totalCount;
    private int pageSize = 10;

    private string sortColumn = "LastName";
    private string sortOrder = "asc";

    private bool isLoading = true;
    private string? errorMessage;

    private RadzenDataGrid<PhoneContact>? grid;

    private PhoneContactFilter filter = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData(new LoadDataArgs
        {
            Skip = 0,
            Top = pageSize
        });
    }

    private async Task LoadData(LoadDataArgs args)
    {
        try
        {
            var skip = args.Skip ?? 0;
            var top = args.Top ?? pageSize;

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                var parts = args.OrderBy.Split(' ');

                sortColumn = parts[0];

                if (parts.Length > 1)
                {
                    sortOrder = parts[1].ToLower();
                }
            }

            var pageNumber = (skip / top) + 1;

            pageSize = top;

            isLoading = true;
            errorMessage = null;

            var result = await PhoneBookApi.GetContactsAsync(
                filter,
                pageNumber, pageSize,
                sortColumn, sortOrder);

            contacts = result.Items;
            totalCount = result.TotalCount;

            UpdateSorting(args.OrderBy);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load contacts.";
            Console.Error.WriteLine(ex);

            contacts = Array.Empty<PhoneContact>();
            totalCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddContact()
    {
        var result = await DialogService.OpenAsync<ContactDialog>(
            "Add Contact",
            new Dictionary<string, object>
            {
            { "Contact", new PhoneContact() }
            },
            new DialogOptions
            {
                Width = "500px",
                Resizable = false,
                Draggable = true
            });

        if (result is PhoneContact newContact)
        {
            await PhoneBookApi.CreateContactAsync(newContact);

            await grid!.Reload();
        }
    }

    private async Task EditContact(PhoneContact contact)
    {
        var result = await DialogService.OpenAsync<ContactDialog>(
            "Edit Contact",
            new Dictionary<string, object>
            {
            { "Contact", contact }
            },
            new DialogOptions
            {
                Width = "500px",
                Resizable = false,
                Draggable = true
            });

        if (result is PhoneContact updatedContact)
        {
            await PhoneBookApi.UpdateContactAsync(updatedContact);

            await grid!.Reload();
        }
    }

    private async Task DeleteContact(PhoneContact contact)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete {contact.FirstName} {contact.LastName}?",
            "Delete Contact",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await PhoneBookApi.DeleteContactAsync(contact.Id);

            await grid!.Reload();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to delete contact.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task Search()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            await LoadData(new LoadDataArgs
            {
                Skip = 0,
                Top = pageSize,
                OrderBy = sortColumn + " " + sortOrder
            });

            if (grid != null)
            {
                await grid.FirstPage();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load contacts.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilter()
    {
        filter = new PhoneContactFilter();

        await Search();
    }

    private void UpdateSorting(string orderBy)
    {
        if (string.IsNullOrWhiteSpace(orderBy))
        {
            sortColumn = "LastName";
            sortOrder = "asc";
            return;
        }

        var parts = orderBy.Split(' ');

        sortColumn = parts[0];
        sortOrder = parts.Length > 1
            ? parts[1].ToLower()
            : "asc";
    }

}
